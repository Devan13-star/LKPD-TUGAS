    <h2>TUGAS PEMROGRAMAN WEB KELAS X RPL</h2>

    <!-- TABEL PAKET HOSTING -->
    <section class="hosting">
        <h3>Paket Hosting Pilihan</h3>

        <div class="hosting-container">

            <div class="paket free">
                <h4>Paket Free</h4>
